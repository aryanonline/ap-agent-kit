{
  "name": "line-beagle",
  "version": "0.0.0",
  "private": true,
  "description": "An accounts-payable inbox for QuickBooks Online that checks every supplier invoice, line by line, against what you agreed to pay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryanonline/ap-agent-kit.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "extract": "tsx scripts/extract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "decimal.js": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
