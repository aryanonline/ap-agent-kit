# Line Beagle: optional settings. Copy this file to .env and fill in only what you need.
# With nothing set, `docker compose up` runs the demo company: no keys, no accounts.
# Never commit .env. Secrets stay empty here on purpose: no secret has a default value.

# Claude: read your own invoices.
# Anthropic Console (https://console.anthropic.com) -> API keys. Set a monthly spend limit there first.
ANTHROPIC_API_KEY=

# QuickBooks Online: connect a sandbox company.
# Intuit Developer (https://developer.intuit.com) -> your app -> Keys and credentials -> Development.
# Development keys connect sandbox companies only.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Add this exact URI to your Intuit app's Development redirect URIs.
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# sandbox is the only environment development keys can reach.
QBO_ENVIRONMENT=sandbox
